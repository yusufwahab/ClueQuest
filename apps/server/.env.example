# ClueQuest server. Copy to .env. NEVER commit real values. Names are validated in src/env.ts at boot.

NODE_ENV=development            # development | test | production
PORT=8790
PUBLIC_WEB_URL=http://localhost:5174       # used in invitation emails and partner launch links
ALLOWED_ORIGINS=http://localhost:5174      # comma-separated exact origins; "*" is refused in production

# --- Database (its own database, separate from ElimQuest) ---
DB_DRIVER=pglite                # pglite = dev/test only (refused in production) | pg
PGLITE_DIR=.pglite-data         # dev only; empty = in-memory
DATABASE_URL=                   # PostgreSQL connection string when DB_DRIVER=pg
DB_POOL_MAX=5

# --- Accounts (teachers and hosts only) ---
AUTH_SECRET=                    # 32+ random characters; required in production (signs sessions and attempt links)
ALLOW_REGISTRATION=true         # false = admin-provisioned teachers only

# --- Email (invitations) ---
EMAIL_MODE=log                  # log = records "not sent" (dev) | brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=ClueQuest

# --- AI assistant (optional, free tiers) ---
# Get a free key: Gemini at https://aistudio.google.com/apikey , Groq at https://console.groq.com/keys
# Gemini is tried first, Groq next if Gemini is busy. Neither key set = the assistant is hidden. Keys stay on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AI_DAILY_LIMIT=20               # generations per host per day
AI_MOCK=false                   # true = fake offline questions for trying the flow without a key

# --- Question pictures (recommended in production) ---
# Pictures that hosts add to questions are stored on Cloudinary and delivered from its CDN, resized for each device.
# Create a free account at https://cloudinary.com , then copy "API Environment variable" from Dashboard > Settings > API Keys.
# It looks like cloudinary://API_KEY:API_SECRET@CLOUD_NAME . Treat it like a password: it only ever lives in this file or your host's settings.
# Leave it empty and pictures are kept in the database instead (fine for local development).
CLOUDINARY_URL=
# Or, instead of CLOUDINARY_URL, the same three values separately (CLOUDINARY_URL wins if both are filled in):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cluequest     # folder inside your Cloudinary account

# --- Optional ---
REDIS_URL=                      # rate-limit counters across instances; in-memory otherwise

# --- Limits and timing ---
MAX_PLAYERS_PER_ROOM=150
ANSWER_GRACE_MS=750             # server allowance after a live deadline for network latency
LAUNCH_TTL_MINUTES=15
WEBHOOK_BACKOFF_MS=30000
WEBHOOK_MAX_TRIES=8

# --- Super admin (optional) ---
SUPER_ADMIN_EMAIL=             # sign in with this email + password and you land on the admin page
SUPER_ADMIN_PASSWORD=          # at least 12 characters in production

# --- Community ---
WHATSAPP_LINK=                  # optional: your WhatsApp group invite link (https://chat.whatsapp.com/...). Players are invited to it after every game

# --- Development only (refused in production) ---
SEED_DEV_DATA=false             # true = demo teacher (host@dev.local / devpassword1) + local test partner
RATE_LIMIT_DISABLED=false
